{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-evidence-graph/0.2/graph-schema.json",
  "title": "Paper evidence graph (graph.json)",
  "description": "Executable structural contract for format_version paper-evidence-graph/0.2. This schema is the single source of truth; the skill's graph-contract.md is a mirror. Semantic aptness/claim-truth are NOT judged here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "paper",
    "evidence_spans",
    "nodes",
    "edges",
    "gaps",
    "provenance_routes",
    "contribution_groups",
    "headline_scan",
    "result_region_scan",
    "extraction"
  ],
  "properties": {
    "format_version": {"const": "paper-evidence-graph/0.2"},
    "paper": {"$ref": "#/$defs/paper"},
    "evidence_spans": {"type": "array", "items": {"$ref": "#/$defs/evidence_span"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "provenance_routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "contribution_groups": {"type": "array", "items": {"$ref": "#/$defs/contribution_group"}},
    "headline_scan": {"type": "array", "items": {"$ref": "#/$defs/headline_entry"}},
    "result_region_scan": {"type": "array", "items": {"$ref": "#/$defs/result_region"}},
    "extraction": {"$ref": "#/$defs/extraction"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "evidence_id": {"type": "string", "pattern": "^ev_[a-z0-9][a-z0-9_]*$"},
    "node_id": {"type": "string", "pattern": "^(art|proc|cfg|res|clm)_[a-z0-9][a-z0-9_]*$"},
    "artifact_id": {"type": "string", "pattern": "^art_[a-z0-9][a-z0-9_]*$"},
    "procedure_id": {"type": "string", "pattern": "^proc_[a-z0-9][a-z0-9_]*$"},
    "configuration_id": {"type": "string", "pattern": "^cfg_[a-z0-9][a-z0-9_]*$"},
    "result_id": {"type": "string", "pattern": "^res_[a-z0-9][a-z0-9_]*$"},
    "claim_id": {"type": "string", "pattern": "^clm_[a-z0-9][a-z0-9_]*$"},
    "edge_id": {"type": "string", "pattern": "^edge_[a-z0-9][a-z0-9_]*$"},
    "gap_id": {"type": "string", "pattern": "^gap_[a-z0-9][a-z0-9_]*$"},
    "route_id": {"type": "string", "pattern": "^route_[a-z0-9][a-z0-9_]*$"},
    "cg_id": {"type": "string", "pattern": "^cg_[a-z0-9][a-z0-9_]*$"},
    "measurement_id": {"type": "string", "pattern": "^res_[a-z0-9][a-z0-9_]*$"},
    "source_span_id": {"type": "string", "pattern": "^p[1-9][0-9]*-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "nonempty_string": {"type": "string", "minLength": 1},

    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "title", "source_path", "source_type", "authoritative_representation"],
      "properties": {
        "paper_id": {"$ref": "#/$defs/nonempty_string"},
        "title": {"$ref": "#/$defs/nonempty_string"},
        "source_path": {"$ref": "#/$defs/nonempty_string"},
        "source_type": {"enum": ["normalized_json", "page_text", "pdf", "plain_text"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authoritative_representation": {"$ref": "#/$defs/nonempty_string"}
      }
    },

    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_plan_path", "coverage_plan_frozen_before_graph", "review_passes", "status", "limitations"],
      "properties": {
        "coverage_plan_path": {"$ref": "#/$defs/nonempty_string"},
        "coverage_plan_frozen_before_graph": {"type": "boolean"},
        "review_passes": {"type": "integer"},
        "status": {"enum": ["complete", "complete_with_source_limitations", "incomplete_source_unreadable"]},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },

    "evidence_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locator", "quote", "quote_fidelity"],
      "properties": {
        "id": {"$ref": "#/$defs/evidence_id"},
        "page": {"type": "integer"},
        "locator": {"$ref": "#/$defs/nonempty_string"},
        "quote": {"$ref": "#/$defs/nonempty_string"},
        "source_span_ids": {"type": "array", "items": {"$ref": "#/$defs/source_span_id"}},
        "quote_fidelity": {"enum": ["exact", "layout_normalized"]}
      }
    },

    "node": {
      "type": "object",
      "required": ["id", "kind", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "kind": {"enum": ["artifact", "procedure", "configuration", "result", "claim"]},
        "label": {"$ref": "#/$defs/nonempty_string"},
        "label_zh": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
        "details": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "artifact"}}, "required": ["kind"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "kind", "label", "evidence_ids"],
            "properties": {
              "id": {"$ref": "#/$defs/node_id"}, "kind": {}, "label": {"$ref": "#/$defs/nonempty_string"},
              "label_zh": {"type": "string"},
              "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
              "details": {"type": "object"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "procedure"}}, "required": ["kind"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "kind", "label", "evidence_ids"],
            "properties": {
              "id": {"$ref": "#/$defs/node_id"}, "kind": {}, "label": {"$ref": "#/$defs/nonempty_string"},
              "label_zh": {"type": "string"},
              "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
              "details": {"type": "object"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "configuration"}}, "required": ["kind"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "kind", "label", "evidence_ids"],
            "properties": {
              "id": {"$ref": "#/$defs/node_id"}, "kind": {}, "label": {"$ref": "#/$defs/nonempty_string"},
              "label_zh": {"type": "string"},
              "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
              "details": {"type": "object"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "result"}}, "required": ["kind"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "kind", "label", "system_or_condition", "paper_locator", "evidence_ids", "measurements"],
            "properties": {
              "id": {"$ref": "#/$defs/node_id"}, "kind": {}, "label": {"$ref": "#/$defs/nonempty_string"},
              "label_zh": {"type": "string"},
              "system_or_condition": {"$ref": "#/$defs/nonempty_string"},
              "paper_locator": {"$ref": "#/$defs/nonempty_string"},
              "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
              "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
              "details": {"type": "object"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "claim"}}, "required": ["kind"]},
          "then": {
            "additionalProperties": false,
            "required": ["id", "kind", "label", "claim_form", "salience_evidence_ids"],
            "properties": {
              "id": {"$ref": "#/$defs/node_id"}, "kind": {}, "label": {"$ref": "#/$defs/nonempty_string"},
              "label_zh": {"type": "string"},
              "claim_form": {"enum": ["comparative", "absolute", "trend", "association", "interpretive"]},
              "salience_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
              "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
              "details": {"type": "object"}
            }
          }
        }
      ]
    },

    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "raw_text", "numeric_value", "unit", "qualifier", "availability", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/measurement_id"},
        "metric": {"$ref": "#/$defs/nonempty_string"},
        "raw_text": {"type": "string"},
        "numeric_value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "qualifier": {"type": ["string", "null"]},
        "direction": {"type": ["string", "null"]},
        "availability": {"enum": ["reported", "not_reported", "not_applicable"]},
        "uncertainty": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind", "raw_text", "numeric_value"],
          "properties": {
            "kind": {"type": "string"},
            "raw_text": {"type": "string"},
            "numeric_value": {"type": ["number", "null"]}
          }
        },
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}}
      }
    },

    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "relation", "to", "assertion_level", "evidence_ids", "rationale"],
      "properties": {
        "id": {"$ref": "#/$defs/edge_id"},
        "from": {"$ref": "#/$defs/node_id"},
        "relation": {"type": "string", "minLength": 1},
        "to": {"$ref": "#/$defs/node_id"},
        "assertion_level": {"enum": ["explicit", "reconstructed"]},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
        "rationale": {"$ref": "#/$defs/nonempty_string"},
        "measurement_ids": {"type": "array", "items": {"$ref": "#/$defs/measurement_id"}},
        "comparison_result_ids": {"type": "array", "items": {"$ref": "#/$defs/result_id"}}
      }
    },

    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "affects", "missing_content", "searched_locations", "question"],
      "properties": {
        "id": {"$ref": "#/$defs/gap_id"},
        "category": {"enum": ["missing_artifact", "missing_producer", "underspecified_configuration", "missing_evaluator", "unconnected_result", "unsupported_claim", "ambiguous_mapping", "other"]},
        "affects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected_kind": {"type": "string"},
        "between": {"type": "array", "items": {"type": "string"}},
        "missing_content": {"$ref": "#/$defs/nonempty_string"},
        "searched_locations": {"type": "array", "items": {"type": "string"}},
        "question": {"$ref": "#/$defs/nonempty_string"}
      }
    },

    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result_id", "subject_procedure_ids", "subject_output_id", "subject_variant", "measurement_ids", "path", "additional_input_ids", "configuration_ids", "gap_ids", "path_edge_ids", "branch_edge_ids", "assertion_level"],
      "properties": {
        "id": {"$ref": "#/$defs/route_id"},
        "result_id": {"$ref": "#/$defs/result_id"},
        "subject_procedure_ids": {"type": "array", "items": {"$ref": "#/$defs/procedure_id"}},
        "subject_output_id": {"type": ["string", "null"], "pattern": "^art_[a-z0-9][a-z0-9_]*$"},
        "subject_variant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "condition_evidence_ids", "distinguishing_configuration_ids"],
          "properties": {
            "label": {"$ref": "#/$defs/nonempty_string"},
            "condition_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
            "distinguishing_configuration_ids": {"type": "array", "items": {"$ref": "#/$defs/configuration_id"}}
          }
        },
        "measurement_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measurement_id"}},
        "path": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "additional_input_ids": {"type": "array", "items": {"$ref": "#/$defs/node_id"}},
        "configuration_ids": {"type": "array", "items": {"$ref": "#/$defs/configuration_id"}},
        "gap_ids": {"type": "array", "items": {"$ref": "#/$defs/gap_id"}},
        "path_edge_ids": {"type": "array", "items": {"type": ["string", "null"], "pattern": "^edge_[a-z0-9][a-z0-9_]*$"}},
        "branch_edge_ids": {"type": "array", "items": {"$ref": "#/$defs/edge_id"}},
        "assertion_level": {"enum": ["explicit", "reconstructed"]}
      }
    },

    "contribution_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "member_node_ids", "headline_claim_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/cg_id"},
        "title": {"$ref": "#/$defs/nonempty_string"},
        "type": {"enum": ["structural", "empirical", "mixed"]},
        "salience_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
        "member_node_ids": {"type": "array", "items": {"$ref": "#/$defs/node_id"}},
        "headline_claim_ids": {"type": "array", "items": {"$ref": "#/$defs/claim_id"}}
      }
    },

    "headline_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "disposition"],
      "properties": {
        "obligation_id": {"$ref": "#/$defs/nonempty_string"},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
        "disposition": {"enum": ["structural_contribution", "empirical_claim", "merged_duplicate", "local_annotation", "excluded_with_reason"]},
        "target_ids": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      }
    },

    "result_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "decision", "reason"],
      "properties": {
        "region": {"$ref": "#/$defs/nonempty_string"},
        "decision": {"enum": ["included_full", "included_selected_conditions", "excluded_as_derived", "excluded_non_result", "unreadable"]},
        "reason": {"$ref": "#/$defs/nonempty_string"},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}},
        "planned_unit_labels": {"type": "array", "items": {"type": "string"}},
        "extracted_result_ids": {"type": "array", "items": {"$ref": "#/$defs/result_id"}},
        "missing_planned_units": {"type": "array", "items": {"type": "string"}},
        "unexpected_units": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
